# Copier ce fichier vers .env puis renseigner les valeurs locales
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=boutique_liberation

# Remplacer par une longue clé secrète privée
SECRET_KEY=change-this-to-a-long-random-secret

# NetiKash : remplir uniquement après confirmation de l'environnement
NETIKASH_CLIENT_ID=
NETIKASH_CLIENT_SECRET=
NETIKASH_ENV=
# URL de base communiquée par NetiKash pour Sandbox ou Production
NETIKASH_API_BASE_URL=
NETIKASH_AUTH_URL=https://accounts.netikash.com/oauth2/token
NETIKASH_CURRENCY=USD
# signing_key de la destination webhook NetiKash
NETIKASH_WEBHOOK_SECRET=
